{
  "name": "@digi-switchride/location",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone India reverse-geocoding service for Digi-Switchride and other applications",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "seed": "tsx src/seed.ts",
    "import-osm": "tsx src/import-osm.ts",
    "bench": "tsx src/bench.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/parse.test.ts test/geocode.test.ts test/http.test.ts test/throughput.test.ts test/samples.test.ts",
    "entrypoint": "node dist/entrypoint.js"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "fflate": "^0.8.2",
    "osm-pbf-parser": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
