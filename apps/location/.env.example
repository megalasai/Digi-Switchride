# HTTP
PORT=4100
HOST=0.0.0.0

# SQLite file created by `npm run seed`
# LOCATION_DB=C:\Users\Megala\Projects\Digi-Switchride\apps\location\data\india.sqlite

# Repeated coordinates skip the database. Set to 0 to always query SQLite.
LOCATION_CACHE_SIZE=50000

# One process handles well over 100,000 requests / 10 minutes.
# Use an integer or "auto" to fork one worker per CPU.
LOCATION_WORKERS=1

# Comma-separated name:key pairs. Empty disables auth (local development).
# LOCATION_API_KEYS=switchride:replace-me,fleet-tracker:replace-me

LOCATION_CORS_ORIGIN=*
