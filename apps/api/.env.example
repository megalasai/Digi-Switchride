PORT=4000
MONGODB_URI=mongodb://localhost:27017/switchride
JWT_SECRET=dev-secret-key-min-32-chars-long!!
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Optional: replica-host URI if mongodb+srv DNS fails (not the SRV alias itself)
# MONGODB_URI_DIRECT=mongodb://user:pass@db-mdb-blr1-xxxx.mongo.ondigitalocean.com:27017/switchride?tls=true&authSource=admin&replicaSet=db-mdb-blr1-25924

# Admin bootstrap (created on first API start if no admin exists)
ADMIN_EMAIL=admin@digiswitchride.com
ADMIN_PASSWORD=Admin@123
PASSWORD_SALT=dev-salt
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

LOCATION_API_URL=http://localhost:4100
LOCATION_API_KEY=

# Track360 telematics pull (IoT device list + live GPS)
TRACK360_PULL_URL=https://prod-s1.track360.net.in/api/v1/auth/pull_api
TRACK360_USERNAME=tyotaadmin
TRACK360_PASSWORD=Admin@123

