PORT=4000
MONGODB_URI=mongodb://localhost:27017/switchride
JWT_SECRET=dev-secret-key-min-32-chars-long!!
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Optional: non-SRV override for Windows/Atlas compatibility
# MONGODB_URI_DIRECT=mongodb://user:pass@host:27017/switchride?ssl=true&authSource=admin

