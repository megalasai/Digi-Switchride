ADMIN_EMAIL=admin@digiswitchride.com
ADMIN_PASSWORD=Admin@123
PASSWORD_SALT=dev-salt
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

LOCATION_API_URL=http://localhost:4100
LOCATION_API_KEY=

# Track360 telematics pull (IoT device list + live GPS)
TRACK360_PULL_URL=https://prod-s1.track360.net.in/api/v1/auth/pull_api
