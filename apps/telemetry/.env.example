# SQLite config (created on first start)
TELEMETRY_SQLITE=data/telemetry.sqlite

TELEMETRY_HTTP_ENABLED=true
TELEMETRY_HTTP_HOST=0.0.0.0
TELEMETRY_HTTP_PORT=4200
TELEMETRY_HTTP_API_KEY=dev-gps-ingest

TELEMETRY_TCP_ENABLED=true
TELEMETRY_TCP_HOST=0.0.0.0
TELEMETRY_TCP_PORT=4210

# WanWay / GT06 GPS (deploy this service on a droplet/VM, not App Platform)
WANWAY_TCP_ENABLED=true
WANWAY_TCP_HOST=0.0.0.0
WANWAY_TCP_PORTS=21100,5001,8821

TELEMETRY_MQTT_ENABLED=false
TELEMETRY_MQTT_URL=mqtt://127.0.0.1:1883
TELEMETRY_MQTT_TOPIC=digi-switchride/gps/#

# Other standalone app — India location API
LOCATION_API_URL=http://localhost:4100
LOCATION_API_PATH=/v1/locations/reverse
LOCATION_API_KEY=
LOCATION_API_TIMEOUT_MS=1500

# Main Digi-Switchride database — GPS is stored here (same cluster as the API)
# Droplet: copy to /opt/telemetry/.env and put the real password. Do not commit the password.
MONGODB_URI=mongodb+srv://switchride_app:PASSWORD@db-mdb-blr1-25924-b48d6f39.mongo.ondigitalocean.com/switchride?tls=true&authSource=admin&replicaSet=db-mdb-blr1-25924
PLATFORM_API_URL=https://fleetel-switchride-pmxt5.ondigitalocean.app
PLATFORM_TELEMETRY_PATH=/api/v1/internal/iot/telemetry

TRAIL_WINDOW_MS=90000
HUB_CACHE_MS=30000
