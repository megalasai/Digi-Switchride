# Copy to .env.poc on the droplet (never commit .env.poc).
#   cp infra/digitalocean/env.poc.example infra/digitalocean/.env.poc

# Browser origin for the admin portal (droplet IP or https://your-domain)
PUBLIC_ORIGIN=http://YOUR_DROPLET_IP:3000

# Optional HTTPS later (A records: apex, api, location, telemetry)
# POC_DOMAIN=poc.switchride.example.com

# API bootstrap — change after first login
JWT_SECRET=replace-with-32-plus-random-characters!!
JWT_EXPIRES_IN=7d
PASSWORD_SALT=replace-with-random-salt
ADMIN_EMAIL=admin@digiswitchride.com
ADMIN_PASSWORD=ChangeMeNow!

# Location keys: name:secret pairs. Empty = open (POC only).
LOCATION_API_KEYS=switchride:replace-location-key,telemetry:replace-location-key
LOCATION_API_KEY=replace-location-key

# Telemetry HTTP ingest
TELEMETRY_HTTP_ENABLED=true
TELEMETRY_HTTP_API_KEY=replace-gps-ingest-key
TELEMETRY_TCP_ENABLED=true
TELEMETRY_MQTT_ENABLED=false

# Track360 (optional on POC)
TRACK360_PULL_URL=https://prod-s1.track360.net.in/api/v1/auth/pull_api
TRACK360_USERNAME=
TRACK360_PASSWORD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
