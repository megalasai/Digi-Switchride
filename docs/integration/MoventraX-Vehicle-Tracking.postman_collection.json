{
  "info": {
    "name": "MoventraX vehicle tracking",
    "description": "Partner tracking APIs (API key) and operator setup (admin JWT). Default host is production HTTPS. Switch baseUrl to http://localhost:4000/api for local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://fleetel-switchride-pmxt5.ondigitalocean.app/api" },
    { "key": "adminEmail", "value": "admin@digiswitchride.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "applicationId", "value": "schoolapplication" },
    { "key": "tenantId", "value": "6ac4b568cb1a4bc2181cf1a8" },
    { "key": "deviceId", "value": "352312095160753" },
    { "key": "vehicleId", "value": "6ac4b567cb1a4bc2181cefdb" },
    { "key": "startDateTime", "value": "2026-11-01T00:00:00.000Z" },
    { "key": "endDateTime", "value": "2026-11-15T23:59:59.000Z" }
  ],
  "item": [
    {
      "name": "1. Operator setup (admin JWT)",
      "item": [
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('adminToken', json.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/v1/auth/admin/login",
            "description": "Saves accessToken into collection variable adminToken."
          }
        },
        {
          "name": "Create tracking application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.apiKey) { pm.collectionVariables.set('apiKey', json.apiKey); }",
                  "if (json.applicationId) { pm.collectionVariables.set('applicationId', json.applicationId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"{{applicationId}}\",\n  \"name\": \"School tracking\",\n  \"notes\": \"Partner map for schoolapplication\"\n}"
            },
            "url": "{{baseUrl}}/v1/admin/tracking-partners",
            "description": "apiKey is returned once and saved to the collection."
          }
        },
        {
          "name": "Map tenants",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantIds\": [\"{{tenantId}}\"]\n}"
            },
            "url": "{{baseUrl}}/v1/admin/tracking-partners/{{applicationId}}/tenants"
          }
        },
        {
          "name": "Get tenant mapping",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/v1/admin/tracking-partners/{{applicationId}}/tenants"
          }
        },
        {
          "name": "Map devices and vehicles",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"tenantId\": \"{{tenantId}}\",\n      \"deviceId\": \"352312095160753\",\n      \"vehicleId\": \"6ac4b567cb1a4bc2181cefdb\"\n    },\n    {\n      \"tenantId\": \"{{tenantId}}\",\n      \"deviceId\": \"SIM-TRACK-DEMO\",\n      \"vehicleId\": \"6abb799e25bda6ff2d0c3ac7\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/v1/admin/tracking-partners/{{applicationId}}/assets"
          }
        },
        {
          "name": "Get asset mapping",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/v1/admin/tracking-partners/{{applicationId}}/assets"
          }
        },
        {
          "name": "List applications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/v1/admin/tracking-partners"
          }
        },
        {
          "name": "Rotate API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.apiKey) { pm.collectionVariables.set('apiKey', json.apiKey); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/v1/admin/tracking-partners/{{applicationId}}/rotate-key"
          }
        }
      ]
    },
    {
      "name": "2. Partner tracking (API key)",
      "item": [
        {
          "name": "Get tenant mapping",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/tenants"
          }
        },
        {
          "name": "Get device vehicle tenant mapping",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/assets"
          }
        },
        {
          "name": "Live fleet (all tenants for application)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/live"
          }
        },
        {
          "name": "Live fleet (one tenant)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/live?tenantId={{tenantId}}"
          }
        },
        {
          "name": "Live one vehicle by deviceId",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/live/vehicle?deviceId={{deviceId}}"
          }
        },
        {
          "name": "Live one vehicle by vehicleId",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/live/vehicle?vehicleId={{vehicleId}}"
          }
        },
        {
          "name": "History one vehicle",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/v1/tracking/{{applicationId}}/history?deviceId={{deviceId}}&startDateTime={{startDateTime}}&endDateTime={{endDateTime}}"
          }
        }
      ]
    }
  ]
}
